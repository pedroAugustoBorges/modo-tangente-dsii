# Copie este arquivo para .env e preencha os dados de conexão do Supabase.
# Use os dados de uma única opção de conexão mostrada pelo Supabase.
# O perfil supabase executa as migrations Flyway no schema public ao iniciar.
SUPABASE_JDBC_URL=jdbc:postgresql://SEU_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USER=SEU_USUARIO
SUPABASE_DB_PASSWORD=COLE_A_SENHA_DO_BANCO
DB_POOL_SIZE=5

# Tutor OpenRouter: a chave é lida somente pelo backend e nunca deve ser commitada.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_MAX_OUTPUT_TOKENS=600
OPENROUTER_MAX_HISTORY_EXCHANGES=8
OPENROUTER_MAX_INPUT_CHARACTERS=12000
OPENROUTER_CONNECT_TIMEOUT=PT3S
OPENROUTER_READ_TIMEOUT=PT30S
TUTOR_PROCESSING_TIMEOUT=PT2M
